{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": "container",
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },

    "title": {
        "text": "Different Taxonomic Groups Have Distinct Distributions",
        "subtitle": "Circle size represents recorded species counts; colours distinguish taxonomic groups across Australian states and territories.",
        "fontSize": 22,
        "subtitleFontSize": 14,
        "anchor": "start"
    },

    "projection": {
        "type": "mercator"
    },

    "layer": [
        {
            "data": {
                "url": "australia-states.json",
                "format": {
                    "type": "topojson",
                    "feature": "ne_10m_admin_1_states_provinces"
                }
            },

            "transform": [
                {
                    "filter": "datum.properties.iso_3166_2 === 'AU-WA' || datum.properties.iso_3166_2 === 'AU-NT' || datum.properties.iso_3166_2 === 'AU-SA' || datum.properties.iso_3166_2 === 'AU-QLD' || datum.properties.iso_3166_2 === 'AU-NSW' || datum.properties.iso_3166_2 === 'AU-VIC' || datum.properties.iso_3166_2 === 'AU-TAS' || datum.properties.iso_3166_2 === 'AU-ACT'"
                }
            ],

            "mark": {
                "type": "geoshape",
                "fill": "#F4F4F4",
                "stroke": "#B7BDB8",
                "strokeWidth": 1
            }
        },

        {
            "data": {
                "values": []
            },

            "mark": {
                "type": "circle",
                "opacity": 0.75,
                "stroke": "#ffffff",
                "strokeWidth": 1
            },

            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },

                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },

                "size": {
                    "field": "species_count",
                    "type": "quantitative",
                    "title": "Number of species",
                    "scale": {
                        "range": [40, 900]
                    },
                    "legend": {
                        "orient": "top-left",
                        "format": ",",
                        "titleLimit": 200
                    }
                },

                "color": {
                    "field": "taxonomic",
                    "type": "nominal",
                    "title": "Taxonomic Group",
                    "scale": {
                        "domain": ["Birds", "Mammals", "Amphibians", "Plants"],
                        "range": [
                        "#3478A8",
                        "#8B6BB1",
                        "#F2B705",
                        "#C47A91"
                        ]
                    },
                    "legend": {
                        "orient": "bottom-left",    
                        "titleLimit": 180,
                        "labelLimit": 140
                    }
                },

                "tooltip": [
                    {
                        "field": "State",
                        "type": "nominal",
                        "title": "State / Territory"
                    },
                    {
                        "field": "taxonomic",
                        "type": "nominal",
                        "title": "Taxonomic Group"
                    },
                    {
                        "field": "species_count",
                        "type": "quantitative",
                        "title": "Number of species",
                        "format": ","
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {"state": "WA","longitude": 122,"latitude": -25},
                    {"state": "NT","longitude": 133.5,"latitude": -19},
                    {"state": "SA","longitude": 135,"latitude": -30},
                    {"state": "QLD","longitude": 145,"latitude": -21},
                    {"state": "NSW","longitude": 147,"latitude": -32},
                    {"state": "TAS","longitude": 146.5,"latitude": -42}
                ]
            },

            "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#24352d",
            "align": "center",
            "baseline": "middle"
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "state"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 149.1,
                    "latitude": -35.4,
                    "longitude2": 153,
                    "latitude2": -39
                }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#24352d",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "longitude2": {
                "field": "longitude2"
                },
                "latitude2": {
                "field": "latitude2"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 153,
                    "latitude": -39,
                    "label": "ACT"
                }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#111111",
                "align": "left",
                "baseline": "middle",
                "dx": 6
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "label"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 144.5,
                    "latitude": -37,
                    "longitude2": 140,
                    "latitude2": -42
                }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#24352d",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"},
                "longitude2": {"field": "longitude2"},
                "latitude2": {"field": "latitude2"}
            }
        },

        {
            "data": {
                "values": [
                {
                    "longitude": 138,
                    "latitude": -42.5,
                    "label": "VIC"
                }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#111111",
                "align": "left",
                "baseline": "middle",
                "dx": 6
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "label"
                }
            }
        }
    ]
}