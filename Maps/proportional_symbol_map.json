{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": "container",
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },

    "title": {
        "text": "Distribution of Threatened Taxa Across Australian States",
        "fontSize": 22,
        "subtitleFontSize": 14,
        "anchor": "start"
    },

    "projection": {
        "type": "mercator"
    },

    "layer": [
        {
            "data": {
                "url": "australia-states.json",
                "format": {
                    "type": "topojson",
                    "feature": "ne_10m_admin_1_states_provinces"
                }
            },

            "transform": [
                {
                    "filter": "datum.properties.iso_3166_2 === 'AU-WA' || datum.properties.iso_3166_2 === 'AU-NT' || datum.properties.iso_3166_2 === 'AU-SA' || datum.properties.iso_3166_2 === 'AU-QLD' || datum.properties.iso_3166_2 === 'AU-NSW' || datum.properties.iso_3166_2 === 'AU-VIC' || datum.properties.iso_3166_2 === 'AU-TAS' || datum.properties.iso_3166_2 === 'AU-ACT'"
                }
            ],

            "mark": {
                "type": "geoshape",
                "fill": "#f4f4f4",
                "stroke": "#333333",
                "strokeWidth": 1
            }
        },

        {
            "data": {
                "values": []
            },

            "mark": {
                "type": "circle",
                "opacity": 0.75,
                "stroke": "#ffffff",
                "strokeWidth": 1
            },

            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },

                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },

                "size": {
                    "field": "species_count",
                    "type": "quantitative",
                    "title": "Number of species",
                    "scale": {
                        "range": [100, 1800]
                    }
                },

                "color": {
                    "field": "taxonomic",
                    "type": "nominal",
                    "title": "Taxonomic Group",
                    "scale": {
                        "range": [
                            "#08519C",
                            "#3182BD",
                            "#6BAED6",
                            "#9ECAE1"
                        ]
                    }
                },

                "tooltip": [
                    {
                        "field": "State",
                        "type": "nominal",
                        "title": "State / Territory"
                    },
                    {
                        "field": "taxonomic",
                        "type": "nominal",
                        "title": "Taxonomic Group"
                    },
                    {
                        "field": "species_count",
                        "type": "quantitative",
                        "title": "Number of species",
                        "format": ","
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                {"state": "Western Australia", "longitude": 122, "latitude": -25},
                {"state": "Norther Territory", "longitude": 133.5, "latitude": -19},
                {"state": "South Australia", "longitude": 135, "latitude": -30},
                {"state": "Queensland", "longitude": 145, "latitude": -21},
                {"state": "New South Wales", "longitude": 147, "latitude": -32},
                {"state": "Tasmania", "longitude": 146.5, "latitude": -42}
                ]
            },

            "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#24352d",
            "align": "center",
            "baseline": "middle"
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "state"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 149.1,
                    "latitude": -35.4,
                    "longitude2": 153,
                    "latitude2": -39
                }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#24352d",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "longitude2": {
                "field": "longitude2"
                },
                "latitude2": {
                "field": "latitude2"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 153,
                    "latitude": -39,
                    "label": "Australia Capital Territory"
                }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#111111",
                "align": "left",
                "baseline": "middle",
                "dx": 6
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "label"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 144.5,
                    "latitude": -37,
                    "longitude2": 140,
                    "latitude2": -42
                }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#24352d",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"},
                "longitude2": {"field": "longitude2"},
                "latitude2": {"field": "latitude2"}
            }
        },

        {
            "data": {
                "values": [
                {
                    "longitude": 138,
                    "latitude": -42.5,
                    "label": "Victoria"
                }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#111111",
                "align": "left",
                "baseline": "middle",
                "dx": 6
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "label"
                }
            }
        }
    ]
}