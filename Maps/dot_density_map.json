{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": "container",
    "height": 700,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },

    "title": {
        "text": "Distribution of IUCN Status of Threatened Species",
        "subtitle": "Each dot represents one unique threatened species and differentiate the status of the species by colour",
        "fontSize": 20,
        "subtitleFontSize": 12,
        "anchor": "start"
    },

    "projection": {
    "type": "mercator",
    "center": [133, -27],
    "scale": 900
    },

    "layer": [
        {
            "data": {
                "url": "australia-states.json",
                "format": {
                    "type": "topojson",
                    "feature": "ne_10m_admin_1_states_provinces"
                }
            },

            "transform": [
                {
                    "filter": "datum.properties.iso_3166_2 === 'AU-WA' || datum.properties.iso_3166_2 === 'AU-NT' || datum.properties.iso_3166_2 === 'AU-SA' || datum.properties.iso_3166_2 === 'AU-QLD' || datum.properties.iso_3166_2 === 'AU-NSW' || datum.properties.iso_3166_2 === 'AU-VIC' || datum.properties.iso_3166_2 === 'AU-TAS' || datum.properties.iso_3166_2 === 'AU-ACT'"
                }
            ],

            "mark": {
                "type": "geoshape",
                "fill": "#e5e5e5",
                "size": 25,
                "opacity": 0.65,
                "stroke": "#ffffff",
                "strokeWidth": 1.2
            }
        },

        {
            "data": {
                "values": []
            },

            "mark": {
                "type": "circle",
                "size": 60,
                "opacity": 0.8
            },

            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },

                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },

                "color": {
                    "field": "IUCNStatus",
                    "type": "nominal",
                    "title": "IUCN Status",
                    "scale": {
                        "domain": [
                        "Critically Endangered",
                        "Endangered",
                        "Vulnerable",
                        "Near Threatened",
                        "Least Concern"
                        ],
                        "range": [
                            "#99000D",
                            "#D7301F",
                            "#EF6548",
                            "#FC8D59",
                            "#FDBB84"
                        ]
                    }
                },

                "tooltip": [
                    {
                        "field": "State",
                        "type": "nominal",
                        "title": "State / Territory"
                    },
                    {
                        "field": "taxonomic",
                        "type": "nominal",
                        "title": "Taxonomic Group"
                    },
                    {
                        "field": "IUCNStatus",
                        "type": "nominal",
                        "title": "IUCN Status"
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                {"state": "Western Australia", "longitude": 122, "latitude": -25},
                {"state": "Norther Territory", "longitude": 133.5, "latitude": -19},
                {"state": "South Australia", "longitude": 135, "latitude": -30},
                {"state": "Queensland", "longitude": 145, "latitude": -21},
                {"state": "New South Wales", "longitude": 147, "latitude": -32},
                {"state": "Victoria", "longitude": 145, "latitude": -36.2},
                {"state": "Tasmania", "longitude": 146.5, "latitude": -42},
                {"state": "ACT", "longitude": 149.1, "latitude": -35.4}
                ]
            },

            "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#24352d",
            "align": "center",
            "baseline": "middle"
            },

            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "state"
                }
            }
        }   
    ]
}