{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": "container",
    "height": 700,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },

    "title": {
        "text": "Where Are Threatened Species at Greatest Risk?",
        "subtitle": "Each dot represents one unique species; colour indicates its IUCN conservation status.",
        "fontSize": 22,
        "subtitleFontSize": 14,
        "anchor": "start"
    },

    "projection": {
    "type": "mercator",
    "center": [130, -27],
    "scale": 800
    },

    "layer": [
        {
            "data": {
                "url": "australia-states.json",
                "format": {
                    "type": "topojson",
                    "feature": "ne_10m_admin_1_states_provinces"
                }
            },

            "transform": [
                {
                    "filter": "datum.properties.iso_3166_2 === 'AU-WA' || datum.properties.iso_3166_2 === 'AU-NT' || datum.properties.iso_3166_2 === 'AU-SA' || datum.properties.iso_3166_2 === 'AU-QLD' || datum.properties.iso_3166_2 === 'AU-NSW' || datum.properties.iso_3166_2 === 'AU-VIC' || datum.properties.iso_3166_2 === 'AU-TAS' || datum.properties.iso_3166_2 === 'AU-ACT'"
                }
            ],

            "mark": {
                "type": "geoshape",
                "fill": "#f4f4f4",
                "stroke": "#B7BDB8",
                "strokeWidth": 1
            }
        },

        {
            "data": {
                "values": []
            },

            "mark": {
                "type": "circle",
                "size": 60,
                "opacity": 0.8
            },

            "encoding": {
                "longitude": {
                    "field": "longitude",
                    "type": "quantitative"
                },

                "latitude": {
                    "field": "latitude",
                    "type": "quantitative"
                },

                "color": {
                    "field": "IUCNStatus",
                    "type": "nominal",
                    "title": "IUCN Status",
                    "scale": {
                        "domain": [
                        "Critically Endangered",
                        "Endangered",
                        "Vulnerable",
                        "Near Threatened",
                        "Least Concern"
                        ],
                        "range": [
                            "#99000D",
                            "#D7301F",
                            "#E3A008",
                            "#6BAED6",
                            "#8C969F"
                        ]
                    },
                    "legend": {
                        "orient": "bottom-left",
                        "titleLimit": 200,
                        "labelLimit": 180
                    }
                },

                "tooltip": [
                    {
                        "field": "Binomial",
                        "type": "nominal",
                        "title": "Scientific Name"
                    },
                    {
                        "field": "species_count",
                        "type": "quantitative",
                        "title": "Species Count",
                        "format": ",d"
                    },
                    {
                        "field": "State",
                        "type": "nominal",
                        "title": "State / Territory"
                    },
                    {
                        "field": "taxonomic",
                        "type": "nominal",
                        "title": "Taxonomic Group"
                    },
                    {
                        "field": "IUCNStatus",
                        "type": "nominal",
                        "title": "IUCN Status"
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {"state": "WA","longitude": 122,"latitude": -25},
                    {"state": "NT","longitude": 133.5,"latitude": -19},
                    {"state": "SA","longitude": 135,"latitude": -30},
                    {"state": "QLD","longitude": 145,"latitude": -21},
                    {"state": "NSW","longitude": 147,"latitude": -32},
                    {"state": "TAS","longitude": 146.5,"latitude": -42}
                ]
            },


            "mark": {
            "type": "text",
            "fontSize": 11,
            "fontWeight": "bold",
            "fill": "#24352d",
            "align": "center",
            "baseline": "middle"
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "state"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 149.1,
                    "latitude": -35.4,
                    "longitude2": 152,
                    "latitude2": -39
                }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#24352d",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "longitude2": {
                "field": "longitude2"
                },
                "latitude2": {
                "field": "latitude2"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 151,
                    "latitude": -39.5,
                    "label": "ACT"
                }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#111111",
                "align": "left",
                "baseline": "middle",
                "dx": 6
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "label"
                }
            }
        },
        {
            "data": {
                "values": [
                {
                    "longitude": 144.5,
                    "latitude": -37,
                    "longitude2": 140,
                    "latitude2": -42
                }
                ]
            },
            "mark": {
                "type": "rule",
                "stroke": "#24352d",
                "strokeWidth": 1.2
            },
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"},
                "longitude2": {"field": "longitude2"},
                "latitude2": {"field": "latitude2"}
            }
        },

        {
            "data": {
                "values": [
                {
                    "longitude": 138,
                    "latitude": -42.5,
                    "label": "VIC"
                }
                ]
            },
            "mark": {
                "type": "text",
                "fontSize": 12,
                "fontWeight": "bold",
                "fill": "#111111",
                "align": "left",
                "baseline": "middle",
                "dx": 6
            },
            "encoding": {
                "longitude": {
                "field": "longitude",
                "type": "quantitative"
                },
                "latitude": {
                "field": "latitude",
                "type": "quantitative"
                },
                "text": {
                "field": "label"
                }
            }
        }
    ]
}