{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Threatened species across Australia",
    "subtitle": "Number of unique threatened species recorded by state and territory",
    "fontSize": 22,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "values": "mapData",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.iso_3166_2 === 'AU-WA' || datum.properties.iso_3166_2 === 'AU-NT' || datum.properties.iso_3166_2 === 'AU-SA' || datum.properties.iso_3166_2 === 'AU-QLD' || datum.properties.iso_3166_2 === 'AU-NSW' || datum.properties.iso_3166_2 === 'AU-VIC' || datum.properties.iso_3166_2 === 'AU-TAS' || datum.properties.iso_3166_2 === 'AU-ACT'"
        },
        {
          "lookup": "properties.iso_3166_2",
          "from": {
            "data": {
              "values": "stateCounts"
            },
            "key": "state_code",
            "fields": [
              "State",
              "species_count",
              "standardised_count"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },
      "encoding": {
        "color": {
          "field": "standardised_count",
          "type": "quantitative",
          "title": "Relative species count",
          "scale": {
            "domain": [0, 1],
            "range": ["#F1F4ED", "#285943"]
          },
          "legend": {
            "format": ".1f"
          }
        },
        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Unique Threatened Species",
            "format": ","
          },
          {
            "field": "standardised_count",
            "type": "quantitative",
            "title": "Relative Count (0-1)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
        {"state": "WA","longitude": 122,"latitude": -25},
        {"state": "NT","longitude": 133.5,"latitude": -19},
        {"state": "SA","longitude": 135,"latitude": -30},
        {"state": "QLD","longitude": 145,"latitude": -21},
        {"state": "NSW","longitude": 147,"latitude": -32},
        {"state": "TAS","longitude": 146.5,"latitude": -42}
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#24352d",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 149.1,
            "latitude": -35.4,
            "longitude2": 153,
            "latitude2": -39
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#24352d",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "longitude2"
        },
        "latitude2": {
          "field": "latitude2"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 153,
            "latitude": -39,
            "label": "ACT"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#111111",
        "align": "left",
        "baseline": "middle",
        "dx": 6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "longitude": 144.5,
            "latitude": -37,
            "longitude2": 140,
            "latitude2": -42
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#24352d",
        "strokeWidth": 1.2
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "longitude2": {"field": "longitude2"},
        "latitude2": {"field": "latitude2"}
      }
    },

    {
      "data": {
        "values": [
          {
            "longitude": 138,
            "latitude": -42.5,
            "label": "VIC"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "fill": "#111111",
        "align": "left",
        "baseline": "middle",
        "dx": 6
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}