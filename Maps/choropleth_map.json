{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": "container",
  "height": 500,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },

  "title": {
    "text": "Threatened species across Australia",
    "subtitle": "Number of unique threatened species recorded by state and territory",
    "fontSize": 22,
    "subtitleFontSize": 14,
    "anchor": "start"
  },

  "projection": {
    "type": "mercator"
  },

  "layer": [
    {
      "data": {
        "values": "mapData",
        "format": {
          "type": "topojson",
          "feature": "ne_10m_admin_1_states_provinces"
        }
      },

      "transform": [
        {
          "filter": "datum.properties.iso_3166_2 === 'AU-WA' || datum.properties.iso_3166_2 === 'AU-NT' || datum.properties.iso_3166_2 === 'AU-SA' || datum.properties.iso_3166_2 === 'AU-QLD' || datum.properties.iso_3166_2 === 'AU-NSW' || datum.properties.iso_3166_2 === 'AU-VIC' || datum.properties.iso_3166_2 === 'AU-TAS' || datum.properties.iso_3166_2 === 'AU-ACT'"
        },
        {
          "lookup": "properties.iso_3166_2",
          "from": {
            "data": {
              "values": "stateCounts"
            },
            "key": "state_code",
            "fields": [
              "State",
              "species_count"
            ]
          }
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {
        "color": {
          "field": "species_count",
          "type": "quantitative",
          "title": "Threatened species",
          "scale": {
            "scheme": "greens"
          }
        },

        "tooltip": [
          {
            "field": "State",
            "type": "nominal",
            "title": "State / Territory"
          },
          {
            "field": "species_count",
            "type": "quantitative",
            "title": "Threatened species",
            "format": ","
          }
        ]
      }
    },

    {
      "data": {
        "values": [
          {"state": "Western Australia", "longitude": 122, "latitude": -25},
          {"state": "Norther Territory", "longitude": 133.5, "latitude": -19},
          {"state": "South Australia", "longitude": 135, "latitude": -30},
          {"state": "Queensland", "longitude": 145, "latitude": -21},
          {"state": "New South Wales", "longitude": 147, "latitude": -32},
          {"state": "Victoria", "longitude": 145, "latitude": -36.2},
          {"state": "Tasmania", "longitude": 146.5, "latitude": -42},
          {"state": "ACT", "longitude": 149.1, "latitude": -35.4}
        ]
      },

        "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "fill": "#24352d",
        "align": "center",
        "baseline": "middle"
        },

      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "state"
        }
      }
    }
  ]
}