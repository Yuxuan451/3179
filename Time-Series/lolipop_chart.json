{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 950,
  "height": 550,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "title": {
    "text": "Change in Species Abundance by IUCN Status",
    "subtitle": "Combined abundance compared between 2000 and 2021",
    "fontSize": 22,
    "subtitleFontSize": 14,
    "anchor": "start"
  },
  "data": {
    "values": []
  },
  "layer": [
    {
       "transform": [
        {"filter": "datum.Year === 2021"}
      ],
      "mark": {
        "type": "rule",
        "color": "#D0D0D0",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "Status",
          "type": "nominal",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable",
            "Near Threatened",
            "Least Concern",
            "Conservation Dependent",
            "Extinct"
          ],
          "axis": {
            "title": "IUCN Status",
            "labelFontSize": 14
          }
        },
        "x": {
          "field": "PctChange",
          "type": "quantitative",
          "axis": {
            "title": "Percentage Change from 2000",
            "labelExpr": "datum.value + '%'"
          }
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#CCCCCC",
        "strokeDash": [4, 4],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "datum": 0
        }
      }
    },
    {
      "transform": [
        {"filter": "datum.Year === 2021"}
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 180,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "Status",
          "type": "nominal",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable",
            "Near Threatened",
            "Least Concern"
          ]
        },
        "x": {
          "field": "PctChange",
          "type": "quantitative"
        },
        "color": {
          "field": "Status",
          "type": "nominal",
          "scale": {
            "domain": [
              "Critically Endangered",
              "Endangered",
              "Vulnerable",
              "Near Threatened",
              "Least Concern"
            ],
            "range": [
              "#99000D",
              "#D7301F",
              "#E3A008",
              "#6BAED6",
              "#8C969F"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "Status",
            "type": "nominal",
            "title": "IUCN Status"
          },
          {
            "field": "Year",
            "type": "nominal",
            "title": "Year"
          },
          {
            "field": "Abundance",
            "type": "quantitative",
            "title": "Combined Abundance",
            "format": ","
          },
          {
            "field": "PctChange",
            "type": "quantitative",
            "title": "Change from 2000",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.PctChange !== 0"},
        {
          "calculate": "format(datum.PctChange, '.1f') + '%'",
          "as": "PctLabel"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 10,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#26352C"
      },
      "encoding": {
        "y": {
          "field": "Status",
          "type": "nominal",
          "sort": [
            "Critically Endangered",
            "Endangered",
            "Vulnerable",
            "Near Threatened",
            "Least Concern"
          ]
        },
        "x": {
          "field": "PctChange",
          "type": "quantitative"
        },
        "text": {
          "field": "PctLabel",
          "type": "nominal"
        }
      }
    }
  ]
}