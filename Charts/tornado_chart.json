{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

    "width": 800,
    "height": 500,
    "autosize": {
        "type": "fit",
        "contains": "padding"
    },

    "title": {
        "text": "Threatened Species: Animals vs Plants",
        "subtitle": "Number of unique threatened species by state and territory",
        "fontSize": 22,
        "subtitleFontSize": 14,
        "anchor": "start"
    },

    "data": {
        "values": []
    },

    "transform": [
        {
            "calculate": "abs(datum.species_count)",
            "as": "absolute_count"
        }
    ],

    "encoding": {
        "y": {
            "field": "State",
            "type": "nominal",
            "sort": [
                "New South Wales",
                "Western Australia",
                "South Australia",
                "Victoria",
                "Queensland",
                "Tasmania",
                "Northern Territory",
                "Australian Capital Territory"
            ],
            "axis": {
                "title": null,
                "labelFontSize": 12
            }
        }
    },

    "layer": [

        {
            "transform": [
                {
                    "filter": "datum.group === 'Animals'"
                }
            ],

            "mark": {
                "type": "bar",
                "size": 40
            },

            "encoding": {
                "x": {
                    "field": "species_count",
                    "type": "quantitative",
                    "title": "Number of threatened species",
                    "axis": {
                        "format": "d",
                        "labelExpr": "abs(datum.value)"
                    }
                },

                "color": {
                    "field": "group",
                    "type": "nominal",
                    "scale": {
                        "domain": ["Animals", "Plants"],
                        "range": ["#008C95", "#D45087"]
                    },
                    "legend": {
                        "title": "Species Group",
                        "orient": "top-right",
                        "direction": "horizontal"
                    }
                },

                "tooltip": [
                    {
                        "field": "State",
                        "title": "State / Territory"
                    },
                    {
                        "field": "group",
                        "title": "Group"
                    },
                    {
                        "field": "absolute_count",
                        "title": "Threatened species",
                        "format": ","
                    }
                ]
            }
        },

        {
            "transform": [
                {
                    "filter": "datum.group === 'Plants'"
                }
            ],

            "mark": {
                "type": "bar",
                "size": 40
            },

            "encoding": {
                "x": {
                    "field": "species_count",
                    "type": "quantitative"
                },

                "color": {
                    "value": "#D45087"
                },

                "tooltip": [
                    {
                        "field": "State",
                        "title": "State / Territory"
                    },
                    {
                        "field": "group",
                        "title": "Group"
                    },
                    {
                        "field": "absolute_count",
                        "title": "Threatened species",
                        "format": ","
                    }
                ]
            }
        },

        {
            "mark": {
                "type": "rule",
                "color": "black"
            },

            "encoding": {
                "x": {
                    "datum": 0
                }
            }
        }
    ]
}