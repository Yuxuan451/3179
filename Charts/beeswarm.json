
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 480,
  "title": {
    "text": "Geographic Distribution of Australia's Threatened Species",
    "subtitle": "Each dot represents one species; horizontal position indicates the number of states recorded",
    "fontSize": 19,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "data": {
    "name": "beeswarmData"
  },
  "mark": {
    "type": "circle",
    "size": 65,
    "opacity": 0.72,
    "stroke": "white",
    "strokeWidth": 0.5
  },
  "encoding": {
    "x": {
      "field": "stateCount",
      "type": "quantitative",
      "title": "Number of States Recorded",
      "scale": {
        "zero": true,
        "nice": true
      },
      "axis": {
        "tickMinStep": 1,
        "grid": true
      }
    },
    "y": {
      "field": "swarmY",
      "type": "quantitative",
      "title": "IUCN Conservation Status",
      "scale": {
        "domain": [-0.6, 7.6],
        "reverse": true,
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [0, 1, 2, 3, 4, 5, 6, 7],
        "labelExpr": "datum.value === 0 ? 'Least Concern' : datum.value === 1 ? 'Near Threatened' : datum.value === 2 ? 'Conservation Dependent' : datum.value === 3 ? 'Vulnerable' : datum.value === 4 ? 'Endangered' : datum.value === 5 ? 'Critically Endangered' : datum.value === 6 ? 'Extinct in the Wild' : 'Extinct'",
        "labelLimit": 180,
        "grid": true,
        "tickSize": 0
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": "Taxonomic Group",
      "scale": {
        "domain": [
          "Birds",
          "Mammals",
          "Amphibians",
          "Plants"
        ],
        "range": [                
          "#08519C",
          "#3182BD",
          "#6BAED6",
          "#9ECAE1"
        ]
      },
      "legend": {
        "orient": "bottom"
      }
    },
    "tooltip": [
      {
        "field": "species",
        "type": "nominal",
        "title": "Species"
      },
      {
        "field": "group",
        "type": "nominal",
        "title": "Taxonomic Group"
      },
      {
        "field": "status",
        "type": "nominal",
        "title": "Conservation Status"
      },
      {
        "field": "stateCount",
        "type": "quantitative",
        "title": "States",
        "format": "d"
      },
      {
        "field": "regionCount",
        "type": "quantitative",
        "title": "Regions",
        "format": "d"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#24352d",
      "titleColor": "#24352d",
      "gridColor": "#dfe3dc",
      "domainColor": "#aeb7ad",
      "tickColor": "#aeb7ad"
    },
    "legend": {
      "labelColor": "#24352d",
      "titleColor": "#24352d"
    }
  }
}
